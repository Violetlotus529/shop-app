<h1>Inventory</h1>

<%= form_with url: admin_inventories_path, method: :get, local: true, id: "inventory-filters" do %>
  <input type="text" name="q" value="<%= @q %>" placeholder="商品名 / color / size">

  <select name="stock_state">
    <option value="">all</option>
    <option value="in_stock"     <%= "selected" if params[:stock_state] == "in_stock" %>>in_stock</option>
    <option value="out_of_stock" <%= "selected" if params[:stock_state] == "out_of_stock" %>>out_of_stock</option>
    <option value="low"          <%= "selected" if params[:stock_state] == "low" %>>low (1-4)</option>
  </select>

  <select name="sort">
    <option value="updated_at_desc" <%= "selected" if @sort == "updated_at_desc" %>>updated_at_desc</option>
    <option value="stock_asc"       <%= "selected" if @sort == "stock_asc" %>>stock_asc</option>
    <option value="stock_desc"      <%= "selected" if @sort == "stock_desc" %>>stock_desc</option>
  </select>

  <button type="submit">検索</button>
<% end %>

<hr>

<label>
  編集モード
  <input id="inventory-edit-toggle" type="checkbox">
</label>

<button type="button" id="save-inventories" style="display:none;" disabled>保存</button>

<div id="pagination"></div>

<table border="1" cellpadding="6" cellspacing="0" style="width:100%;">
  <thead>
    <tr>
      <th>Product</th>
      <th>Color</th>
      <th>Size</th>
      <th>Stock</th>
    </tr>
  </thead>
  <tbody id="inventories-body"></tbody>
</table>