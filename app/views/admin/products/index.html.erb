<div class="a-page">

  <div class="a-head">
    <h1 class="a-title">商品一覧</h1>

    <div class="a-actions">
      <%= link_to "新規作成", new_admin_product_path, class: "a-btn a-btn--primary" %>
    </div>
  </div>

  <!-- filters -->
  <div class="a-card">
    <%= form_with url: admin_products_path, method: :get, local: true, class: "a-filters" do %>

      <div class="a-field">
        <label class="a-label">検索</label>
        <input
          type="text"
          name="q"
          value="<%= @q %>"
          placeholder="商品名 / 説明"
          class="a-input"
        >
      </div>

      <div class="a-field">
        <label class="a-label">公開状態</label>
        <select name="status" class="a-select">
          <option value="all" <%= "selected" if @status == "all" %>>全て</option>
          <option value="published" <%= "selected" if @status == "published" %>>公開</option>
          <option value="unpublished" <%= "selected" if @status == "unpublished" %>>非公開</option>
        </select>
      </div>

      <div class="a-field">
        <label class="a-label">並び替え</label>
        <select name="sort" class="a-select">
          <option value="updated_at_desc" <%= "selected" if @sort == "updated_at_desc" %>>新しい順</option>
          <option value="updated_at_asc"  <%= "selected" if @sort == "updated_at_asc"  %>>古い順</option>
        </select>
      </div>

      <div class="a-field a-field--btn">
        <button type="submit" class="a-btn">検索</button>
      </div>

    <% end %>
  </div>

  <!-- table -->
  <div class="a-card a-card--table">
    <div class="a-tableWrap">
      <table class="a-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>商品名</th>
            <th>価格</th>
            <th>公開</th>
            <th>更新日時</th>
            <th></th>
          </tr>
        </thead>

        <tbody>
          <% @products.each do |product| %>
            <tr>
              <td><%= product.id %></td>

              <td>
                <%= link_to product.name, admin_product_path(product) %>
              </td>

              <td>
                ¥<%= number_with_delimiter(product.price_cents) %>
              </td>

              <td>
                <% if product.published? %>
                  <span class="a-badge a-badge--completed">公開</span>
                <% else %>
                  <span class="a-badge a-badge--canceled">非公開</span>
                <% end %>
              </td>

              <td>
                <%= l(product.updated_at) %>
              </td>

              <td>
                <%= link_to "編集", edit_admin_product_path(product), class: "a-btn" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="a-pagination">
      <div>total: <%= @total %></div>
      <div>page: <%= @page %> / <%= [@total_pages, 1].max %></div>

      <% if @page > 1 %>
        <%= link_to "前へ", admin_products_path(request.query_parameters.merge(page: @page - 1)), class: "a-btn" %>
      <% end %>

      <% if @page < @total_pages %>
        <%= link_to "次へ", admin_products_path(request.query_parameters.merge(page: @page + 1)), class: "a-btn" %>
      <% end %>
    </div>

  </div>
</div>