<h1>New Product</h1>

<% if @product.errors.any? %>
  <div class="errors">
    <ul>
      <% @product.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: [:admin, @product], local: true do |f| %>
  <div>
    <%= f.label :name %>
    <%= f.text_field :name %>
  </div>

  <div>
    <%= f.label :category, "カテゴリ" %><br>
    <%= f.select :category,
        Product::CATEGORIES.map { |c| [c, c] },
        include_blank: false %>
  </div>

  <div>
    <%= f.label :price_cents %>
    <%= f.number_field :price_cents %>
  </div>

  <div>
    <%= f.submit "Create product" %>
  </div>
<% end %>