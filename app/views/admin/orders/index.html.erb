<h1>注文一覧</h1>

<%= form_with url: admin_orders_path, method: :get, local: true do %>
  <div style="display:flex; 12px; flex-wrap:wrap; align-items:flex-end;">
    <div>
      <label>検索</label>
      <input type="text" name="q" value="<%= @q %>" placeholder="注文ID / 顧客名 / メール">
    </div>

    <div>
      <label>status</label><br>
      <select name="status">
        <option value="">全て</option>
        <% Order.statuses.keys.each do |s| %>
          <option value="<%= s %>" <%= "selected" if @status == s %>><%= s %></option>
        <% end %>
      </select>
    </div>

    <div>
      <label>from</label><br>
      <input type="date" name="from" value="<%= @from %>">
    </div>

    <div>
      <label>to</label><br>
      <input type="date" name="to" value="<%= @to %>">
    </div>

    <div>
      <label>sort</label><br>
      <select name="sort">
        <option value="created_at_desc" <%= "selected" if @sort == "created_at_desc" %>>新しい順</option>
        <option value="created_at_asc"  <%= "selected" if @sort == "created_at_asc"  %>>古い順</option>
      </select>
    </div>
    <div>
      <button type="submit">検索</button>
      <%= link_to "クリア", admin_orders_path %>
    </div>
  </div>
<% end %>

<hr>

<table border="1" cellpadding="6" cellspacing="0" style="width:100%;">
  <thead>
    <tr>
      <th>ID</th>
      <th>注文日時</th>
      <th>購入者</th>
      <th>ステータス</th>
      <th>合計金額</th>
      <th></th>
    </tr>
  </thead>

  <tbody>
    <% @orders.each do |o| %>
      <tr>
        <td><%= o.id %></td>
        <td><%= l(o.created_at) %></td>
        <td>
          <div><%= o.customer_name %></div>
          <div style="opacity:.7;"><%= o.customer_email %></div>
        </td>
        <td><%= o.status %></td>
        <td><%= number_to_currency(o.total_cents, unit: "¥", precision: 0) %></td>
        <td><%= o.unique_product_count %>点</td>
        <td><%= link_to "詳細", admin_order_path(o) %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<hr>

<div style="display:flex; 12px; align-items:center;">
  <div>total: <%= @total %></div>
  <div>page: <%= @page %> / <%= [@total_pages, 1].max %></div>

  <div style="margin-left:auto;">
    <% if @page > 1 %>
      <%= link_to "前へ", admin_orders_path(request.query_parameters.merge(page: @page - 1)) %>
    <% end %>

    <% if @page < @total_pages %>
      <%= link_to "次へ", admin_orders_path(request.query_parameters.merge(page: @page + 1)) %>
    <% end %>
  </div>
</div>