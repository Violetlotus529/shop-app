<div class="a-page">
  <div class="a-head">
    <h1 class="a-title">Order #<%= @order.id %></h1>

    <div class="a-actions">
      <span class="a-badge a-badge--<%= @order.status %>">
        <%= @order.status_label %>
      </span>
      <% status_labels = {
        "paid" => "支払い完了",
        "processing" => "発送準備中",
        "shipped" => "発送済み",
        "completed" => "完了",
        "canceled" => "キャンセル",
        "failed" => "決済失敗",
        "refunded" => "返金済み"
      } %>

      <% @order.next_status_candidates.each do |st| %>
        <%= button_to status_labels[st] || st, status_admin_order_path(@order, status: st),
              method: :patch,
              class: "a-btn a-btn--primary" %>
      <% end %>
    </div>
  </div>

  <div class="a-grid">
    <!-- 左 -->
    <div class="a-card">
      <h2 class="a-subtitle">注文情報</h2>

      <dl class="a-kv">
        <dt>ID</dt><dd><%= @order.id %></dd>
        <dt>作成日時</dt><dd><%= l @order.created_at %></dd>
        <dt>支払い</dt><dd>credit</dd>
        <dt>合計</dt><dd>¥<%= @order.total_cents %></dd>
      </dl>
    </div>

    <!-- 中央 -->
    <div class="a-card">
      <h2 class="a-subtitle">購入商品</h2>

      <table class="a-table">
        <thead>
          <tr>
            <th>Product</th>
            <th>Variant</th>
            <th>Qty</th>
            <th>Price</th>
          </tr>
        </thead>
        <tbody>
          <% @order.order_items.each do |oi| %>
            <tr>
              <td><%= oi.product_variant.product.name %></td>
              <td><%= oi.product_variant.color %> / <%= oi.product_variant.size %></td>
              <td><%= oi.quantity %></td>
              <td>¥<%= oi.subtotal_cents %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <!-- 右 -->
    <div class="a-card">
      <h2 class="a-subtitle">配送・顧客</h2>

      <dl class="a-kv">
        <dt>名前</dt><dd><%= @order.customer_name %></dd>
        <dt>Email</dt><dd><%= @order.customer_email %></dd>
        <dt>住所</dt>
        <dd>
          <%= @order.postal_code %><br>
          <%= @order.prefecture %> <%= @order.city %><br>
          <%= @order.address_line1 %><br>
          <%= @order.address_line2 %>
        </dd>
      </dl>
    </div>
  </div>
</div>