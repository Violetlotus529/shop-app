<section class="section">
  <h1 class="h1">マイページ</h1>

  <div class="stack-24">
    <%= form_with model: @customer, url: my_page_path, method: :patch, class: "form" do |f| %>
      <%= render "shared/form_errors", object: @customer %>

      <div class="form__row">
        <%= f.label :name, "氏名", class: "form__label" %>
        <%= f.text_field :name, class: "form__input" %>
      </div>

      <div class="form__row">
        <%= f.label :postal_code, "郵便番号", class: "form__label" %>
        <%= f.text_field :postal_code, class: "form__input", placeholder: "123-4567" %>
      </div>

      <div class="form__row">
        <%= f.label :prefecture, "都道府県", class: "form__label" %>
        <%= f.text_field :prefecture, class: "form__input" %>
      </div>

      <div class="form__row">
        <%= f.label :city, "市区町村", class: "form__label" %>
        <%= f.text_field :city, class: "form__input" %>
      </div>

      <div class="form__row">
        <%= f.label :address_line1, "番地", class: "form__label" %>
        <%= f.text_field :address_line1, class: "form__input" %>
      </div>

      <div class="form__row">
        <%= f.label :address_line2, "建物名（任意）", class: "form__label" %>
        <%= f.text_field :address_line2, class: "form__input" %>
      </div>

      <div class="form__row">
        <%= f.label :phone_number, "電話番号", class: "form__label" %>
        <%= f.text_field :phone_number, class: "form__input" %>
      </div>

      <div class="stack-12" style="max-width: 320px;">
        <%= f.submit "保存", class: "btn btn--primary btn--block" %>
      </div>
    <% end %>
  </div>
</section>