<h1>Cart</h1>

<% if @has_stock_error %>
  <p style="color: #c00;">
    ※選択された商品は在庫が不足しております。数量を調整してください。
  </p>
<% end %>

<% if customer_signed_in? %>
  <% @cart_rows.each do |row| %>
    <% v = row[:variant] %>
    <% qty = row[:quantity] %>
    <% subtotal_cents = row[:subtotal_cents] %>

    <div>
      <strong><%= v.product.name %></strong>
      (<%= v.color %>/<%= v.size %>)

      <div>
        小計:
        <%= number_to_currency(subtotal_cents, unit: "¥", precision: 0) %>
      </div>

      <% if row[:insufficient] %>
        <p style="color: #c00;">
          在庫不足 : 在庫 <%= row[:available_stock] %> / 現在 <%= qty %>
        </p>
      <% end %>

      <%= form_with url: cart_item_path(row[:key]), method: :patch, local: true do %>
        <input
          type="number"
          name="quantity"
          value="<%= qty %>"
          min="1"
          max="<%= row[:available_stock] %>"
        >
        <button type="submit">数量更新</button>
      <% end %>

      <% if row[:insufficient] && row[:available_stock] > 0 %>
        <%= button_to "在庫数を合わせる",
              cart_item_path(row[:key]),
              method: :patch,
              params: { quantity: row[:available_stock] } %>
      <% end %>

      <%= button_to(
            "削除",
            cart_item_path(row[:key]),
            method: :delete,
            data: { turbo_confirm: "削除しますか？" }
          ) %>
    </div>

    <hr>
  <% end %>

<% else %>
  <% @cart_rows.each do |row| %>
    <% v = row[:variant] %>
    <% qty = row[:quantity] %>
    <% subtotal_cents = row[:subtotal_cents] %>

    <div>
      <strong><%= v.product.name %></strong>
      (<%= v.color %>/<%= v.size %>)

      <div>
        小計:
        <%= number_to_currency(subtotal_cents, unit: "¥", precision: 0) %>
      </div>

      <% if row[:insufficient] %>
        <p style="color: #c00;">
          在庫不足 : 在庫 <%= row[:available_stock] %> / 現在 <%= qty %>
        </p>
      <% end %>

      <%= form_with url: cart_item_path(row[:key]), method: :patch, local: true do %>
        <input
          type="number"
          name="quantity"
          value="<%= qty %>"
          min="1"
          max="<%= row[:available_stock] %>"
        >
        <button type="submit">数量更新</button>
      <% end %>

      <% if row[:insufficient] && row[:available_stock] > 0 %>
        <%= button_to "在庫数を合わせる",
              cart_item_path(row[:key]),
              method: :patch,
              params: { quantity: row[:available_stock] } %>
      <% end %>


      <%= button_to(
            "削除",
            cart_item_path(row[:key]),
            method: :delete,
            data: { turbo_confirm: "削除しますか？" }
          ) %>
    </div>

    <hr>
  <% end %>
<% end %>

<div style="margin-top: 20px;">
  <strong>
    合計金額:
    <%= number_to_currency(@total_cents, unit: "¥", precision: 0) %>
  </strong>
</div>

<% has_items = @cart_rows.present? %>
<% can_checkout = has_items && !@has_stock_error %>

<% if has_items %>
  <hr>
  <%= form_with url: checkout_path, method: :post, local: true do %>
    <% unless customer_signed_in? %>
      <div><input name="customer_name" placeholder="氏名" required></div>
      <div><input name="customer_email" placeholder="Email" required></div>
      <div><input name="postal_code" inputmode="numeric" pattern="\d{3}-?\d{4}" placeholder="郵便番号" required></div>
      <div><input name="prefecture" placeholder="都道府県" required></div>
      <div><input name="city" placeholder="市区町村" required></div>
      <div><input name="address_line1" placeholder="番地" required></div>
      <div><input name="address_line2" placeholder="建物名"></div>
    <% end %>

    <button type="submit" style="margin-top: 16px;" <%= "disabled" unless can_checkout %>>
      決済へ進む
    </button>

    <% unless can_checkout %>
      <p style="color:#c00;">在庫不足の商品があるため決済できません。</p>
    <% end %>
  <% end %>
<% else %>
  <p>カートは空です。</p>
<% end %>
