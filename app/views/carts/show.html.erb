<h1>Cart</h1>

<% if customer_signed_in? %>
  <% @cart_items.each do |item| %>
    <% v = item.product_variant %>
    <% subtotal_cents = item.quantity * v.product.price_cents %>

    <div>
      <strong><%= v.product.name %></strong>
      (<%= v.color %>/<%= v.size %>)

      <div>
        小計:
        <%= number_to_currency(subtotal_cents, unit: "¥", precision: 0) %>
      </div>

      <%= form_with url: cart_item_path(item), method: :patch, local: true do %>
        <input
          type="number"
          name="quantity"
          value="<%= item.quantity %>"
          min="1"
        >
        <button type="submit">数量更新</button>
      <% end %>

      <%= button_to(
            "削除",
            cart_item_path(item),
            method: :delete,
            data: { turbo_confirm: "削除しますか？" }
          ) %>
    </div>

    <hr>
  <% end %>

<% else %>
  <% @guest_items.each do |row| %>
    <% v = row[:variant] %>
    <% qty = row[:quantity] %>
    <% subtotal_cents = row[:subtotal_cents] %>

    <div>
      <strong><%= v.product.name %></strong>
      (<%= v.color %>/<%= v.size %>)

      <div>
        小計:
        <%= number_to_currency(subtotal_cents, unit: "¥", precision: 0) %>
      </div>

      <%= form_with url: cart_item_path(v.id), method: :patch, local: true do %>
        <input
          type="number"
          name="quantity"
          value="<%= qty %>"
          min="1"
        >
        <button type="submit">数量更新</button>
      <% end %>

      <%= button_to(
            "削除",
            cart_item_path(v.id),
            method: :delete,
            data: { turbo_confirm: "削除しますか？" }
          ) %>
    </div>

    <hr>
  <% end %>
<% end %>

<div style="margin-top: 20px;">
  <strong>
    合計金額:
    <%= number_to_currency(@total_cents, unit: "¥", precision: 0) %>
  </strong>
</div>

<% has_items = customer_signed_in? ? @cart_items.present? : @guest_items.present? %>

<% if has_items %>
  <hr>
  <%= form_with url: checkout_path, method: :post, local: true do %>
    <% unless customer_signed_in? %>
      <div><input name="customer_name" placeholder="氏名" required></div>
      <div><input name="customer_email" placeholder="Email" required></div>
      <div><input name="postal_code" inputmode="numeric" pattern="\d{3}-?\d{4}" placeholder="郵便番号" required></div>
      <div><input name="prefecture" placeholder="都道府県" required></div>
      <div><input name="city" placeholder="市区町村" required></div>
      <div><input name="address_line1" placeholder="番地" required></div>
      <div><input name="address_line2" placeholder="建物名"></div>
    <% end %>

    <button type="submit" style="margin-top: 16px;">
      決済へ進む
    </button>
  <% end %>
<% else %>
  <p>カートは空です。</p>
<% end %>
