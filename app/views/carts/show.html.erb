<section class="section">
  <h1 class="h1">Cart</h1>

  <div class="stack-24">
    <% if @has_stock_error %>
      <div class="notice notice--danger">
        在庫不足の商品があります。数量を調整してください。
      </div>
    <% end %>

    <% has_items = @cart_rows.present? %>
    <% can_checkout = has_items && !@has_stock_error %>

    <% if has_items %>
      <div class="cart">
        <div class="cart__items stack-12">
          <% @cart_rows.each do |row| %>
            <% v   = row[:variant] %>
            <% qty = row[:quantity] %>

            <div class="cart-item">
              <div class="cart-item__main">
                <div class="cart-item__title">
                  <%= v.product.name %>
                  <span class="cart-item__variant text-sm text-muted">(<%= v.color %> / <%= v.size %>)</span>
                </div>

                <div class="cart-item__meta">
                  <div class="text-sm text-muted">小計</div>
                  <div class="cart-item__subtotal">
                    <%= number_to_currency(row[:subtotal_cents], unit: "¥", precision: 0) %>
                  </div>
                </div>
              </div>

              <div class="cart-item__actions">
                <div class="cart-item__status stack-8">
                  <div class="text-sm text-muted">
                    INSTOCK <%= row[:available_stock] %> items
                  </div>

                  <% if row[:available_stock] == 0 %>
                    <div class="text-sm" style="color:#c00;">SOLD OUT</div>
                  <% elsif row[:insufficient] %>
                    <div class="text-sm" style="color:#c00;">
                      在庫不足（在庫: <%= row[:available_stock] %> / 現在: <%= qty %>）
                    </div>
                    <div class="text-sm" style="color:#c00;">
                      数量を減らしてから決済してください。
                    </div>
                  <% end %>
                </div>

                <div class="cart-item__qty">
                  <%= form_with url: cart_item_path(row[:key]), method: :patch, local: true, class: "cart-item__qty-form" do %>
                    <input
                      class="form__input cart-item__qty-input"
                      type="number"
                      name="quantity"
                      value="<%= qty %>"
                      min="1"
                      max="<%= row[:available_stock] %>"
                    >
                    <button type="submit" class="btn btn--secondary">数量更新</button>
                  <% end %>
                </div>

                <%= button_to "削除",
                      cart_item_path(row[:key]),
                      method: :delete,
                      data: { turbo_confirm: "削除しますか？" },
                      class: "btn btn--danger" %>
              </div>
            </div>
          <% end %>
        </div>

        <aside class="cart__summary stack-24">
          <div class="summary-card stack-12">
            <div class="summary-card__row">
              <div class="text-sm text-muted">合計</div>
              <div class="summary-card__total">
                <%= number_to_currency(@total_cents, unit: "¥", precision: 0) %>
              </div>
            </div>

            <div class="text-sm text-muted">tax included</div>

            <%= form_with url: checkout_path, method: :post, local: true, data: { turbo: false }, class: "stack-12" do %>
              <% unless customer_signed_in? %>
                <input type="hidden" name="customer_name" id="checkout_customer_name_hidden">
                <input type="hidden" name="customer_email" id="checkout_customer_email_hidden">
                <input type="hidden" name="postal_code" id="checkout_postal_code_hidden">
                <input type="hidden" name="prefecture" id="checkout_prefecture_hidden">
                <input type="hidden" name="city" id="checkout_city_hidden">
                <input type="hidden" name="address_line1" id="checkout_address_line1_hidden">
                <input type="hidden" name="address_line2" id="checkout_address_line2_hidden">
              <% end %>

              <button
                type="submit"
                class="btn btn--primary btn--block"
                data-disable-with="処理中..."
                <%= "disabled" unless can_checkout %>>
                決済へ進む
              </button>

              <% unless can_checkout %>
                <div class="text-sm" style="color:#c00;">
                  在庫不足の商品があるため決済できません。
                </div>
              <% end %>
            <% end %>
          </div>

          <% unless customer_signed_in? %>
            <div class="card stack-12">
              <div class="h2">購入者情報（ゲスト）</div>

              <div class="form__row">
                <label class="form__label" for="customer_name">氏名</label>
                <input
                  id="customer_name"
                  class="form__input js-checkout-copy"
                  data-target="#checkout_customer_name_hidden"
                  name="guest_customer_name"
                  required
                >
              </div>

              <div class="form__row">
                <label class="form__label" for="customer_email">Email</label>
                <input
                  id="customer_email"
                  class="form__input js-checkout-copy"
                  data-target="#checkout_customer_email_hidden"
                  name="guest_customer_email"
                  required
                >
              </div>

              <div class="form__row">
                <label class="form__label" for="postal_code">郵便番号</label>
                <input
                  id="postal_code"
                  class="form__input js-checkout-copy"
                  data-target="#checkout_postal_code_hidden"
                  name="guest_postal_code"
                  inputmode="numeric"
                  pattern="\d{3}-?\d{4}"
                  placeholder="123-4567"
                  required
                >
              </div>

              <div class="form__row">
                <label class="form__label" for="prefecture">都道府県</label>
                <input
                  id="prefecture"
                  class="form__input js-checkout-copy"
                  data-target="#checkout_prefecture_hidden"
                  name="guest_prefecture"
                  required
                >
              </div>

              <div class="form__row">
                <label class="form__label" for="city">市区町村</label>
                <input
                  id="city"
                  class="form__input js-checkout-copy"
                  data-target="#checkout_city_hidden"
                  name="guest_city"
                  required
                >
              </div>

              <div class="form__row">
                <label class="form__label" for="address_line1">番地</label>
                <input
                  id="address_line1"
                  class="form__input js-checkout-copy"
                  data-target="#checkout_address_line1_hidden"
                  name="guest_address_line1"
                  required
                >
              </div>

              <div class="form__row">
                <label class="form__label" for="address_line2">建物名（任意）</label>
                <input
                  id="address_line2"
                  class="form__input js-checkout-copy"
                  data-target="#checkout_address_line2_hidden"
                  name="guest_address_line2"
                >
              </div>
            </div>
          <% end %>
        </aside>
      </div>
    <% else %>
      <div class="notice">カートは空です。</div>
      <div class="stack-12" style="max-width:320px;">
        <%= link_to "商品一覧へ", products_path, class: "btn btn--primary btn--block" %>
      </div>
    <% end %>
  </div>
</section>

<% unless customer_signed_in? %>
  <script>
    document.addEventListener("turbo:load", function () {
      document.querySelectorAll(".js-checkout-copy").forEach(function (input) {
        const sync = function () {
          const hidden = document.querySelector(input.dataset.target);
          if (hidden) hidden.value = input.value;
        };

        input.addEventListener("input", sync);
        sync();
      });
    });
  </script>
<% end %>