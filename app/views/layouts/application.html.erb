<!-- app/views/layouts/application.html.erb -->
<!DOCTYPE html>
<html>
  <head>
    <title>ShopApp</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="l-header">
      <div class="l-header__inner">
        <%= link_to "VIOLETLOTUS", root_path, class: "l-brand" %>

        <nav class="l-nav">
          <% if current_page?(root_path) %>
            <span class="nav-link is-current">Products</span>
          <% else %>
            <%= link_to "Products", root_path, class: "nav-link" %>
          <% end %>

          <% if current_page?(cart_path) %>
            <span class="nav-link is-current">Cart</span>
          <% else %>
            <%= link_to "Cart", cart_path, class: "nav-link" %>
          <% end %>

          <% if customer_signed_in? %>
            <% if current_page?(my_page_path) %>
              <span class="nav-link is-current">MyPage</span>
            <% else %>
              <%= link_to "MyPage", my_page_path, class: "nav-link" %>
            <% end %>

            <% if current_page?(orders_path) %>
              <span class="nav-link is-current">Orders</span>
            <% else %>
              <%= link_to "Orders", orders_path, class: "nav-link" %>
            <% end %>

            <%= button_to "Logout",
                  destroy_customer_session_path,
                  method: :delete,
                  class: "btn-linklike",
                  form_class: "l-nav__logout" %>
          <% else %>
            <% if current_page?(new_customer_session_path) %>
              <span class="nav-link is-current">Login</span>
            <% else %>
              <%= link_to "Login", new_customer_session_path, class: "nav-link" %>
            <% end %>

            <% if current_page?(new_guest_order_lookup_path) %>
              <span class="nav-link is-current">Guest Lookup</span>
            <% else %>
              <%= link_to "Guest Lookup", new_guest_order_lookup_path, class: "nav-link" %>
            <% end %>
          <% end %>
        </nav>
      </div>
    </header>

    <%= render "shared/flash" %>

    <main class="l-main">
      <%= yield %>
    </main>
  </body>
</html>