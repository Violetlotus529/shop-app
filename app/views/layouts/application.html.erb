<!DOCTYPE html>
<html>
  <head>
    <title>ShopApp</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head> 

  <body>
    <header>
      <div class="header-actions">
        <% if current_page?(root_path) %>
          <span class="header-link is-current">Products</span>
        <% else %>
          <%= link_to "Products", root_path, class: "header-link" %>
        <% end %>

        <% if current_page?(cart_path) %>
          <span class="header-link is-current">Cart</span>
        <% else %>
          <%= link_to "Cart", cart_path, class: "header-link" %>
        <% end %>

        <% if customer_signed_in? %>
          <% if current_page?(my_page_path) %>
            <span class="header-link is-current">MyPage</span>
          <% else %>
            <%= link_to "MyPage", my_page_path, class: "header-link" %>
          <% end %>

          <% if current_page?(orders_path) %>
            <span class="header-link is-current">Orders</span>
          <% else %>
            <%= link_to "Orders", orders_path, class: "header-link" %>
          <% end %>

          <%= button_to "Logout", destroy_customer_session_path, method: :delete, class: "header-link" %>
        <% else %>
          <% if current_page?(new_customer_session_path) %>
            <span class="header-link is-current">Login</span>
          <% else %>
            <%= link_to "Login", new_customer_session_path, class: "header-link" %>
          <% end %>

          <% if current_page?(new_guest_order_lookup_path) %>
            <span class="header-link is-current">Guest Lookup</span>
          <% else %>
            <%= link_to "Guest Lookup", new_guest_order_lookup_path, class: "header-link" %>
          <% end %>
        <% end %>
      <div>
    </header>

    <%= render "shared/flash" %>
    <%= yield %>
  </body>
</html>
