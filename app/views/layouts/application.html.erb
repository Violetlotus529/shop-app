<!DOCTYPE html>
<html>
  <head>
    <title>ShopApp</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head> 

  <body>
    <header>
      <div class="header-actions">
        <% if customer_signed_in? %>
          <%= link_to "MyPage", my_page_path, class: "header-link" %>
          <%= link_to "Orders", orders_path, class: "header-link" %>
          <%= button_to "Logout", destroy_customer_session_path, method: :delete, class: "header-link" %>
        <% else %>
          <%= link_to "Login", new_customer_session_path, class: "header-link" %>
        <% end %>
      <div>
    </header>

    <%= render "shared/flash" %>
    <%= yield %>
  </body>
</html>
