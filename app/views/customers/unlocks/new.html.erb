<section class="section">
  <h1 class="h1">ロック解除メール再送</h1>

  <div class="stack-24">
    <%= form_for(resource, as: resource_name, url: unlock_path(resource_name), html: { method: :post, class: "form" }) do |f| %>
      <%= render "customers/shared/error_messages", resource: resource %>

      <div class="form__row">
        <%= f.label :email, "Email", class: "form__label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form__input" %>
      </div>

      <div class="stack-12" style="max-width: 420px;">
        <%= f.submit "ロック解除メールを送信", class: "btn btn--primary btn--block" %>
      </div>
    <% end %>

    <div class="auth-links">
      <%= render "customers/shared/links" %>
    </div>
  </div>
</section>