<section class="section">
  <h1 class="h1">新規登録</h1>

  <div class="stack-24">
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "form" }) do |f| %>
      <%= render "customers/shared/error_messages", resource: resource %>

      <div class="form__row">
        <%= f.label :email, "Email", class: "form__label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form__input" %>
      </div>

      <div class="form__row">
        <%= f.label :password, "パスワード", class: "form__label" %>
        <%= f.password_field :password, autocomplete: "new-password", class: "form__input" %>
        <% if @minimum_password_length %>
          <div class="text-sm text-muted"><%= @minimum_password_length %>文字以上</div>
        <% end %>
      </div>

      <div class="form__row">
        <%= f.label :password_confirmation, "パスワード（確認）", class: "form__label" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form__input" %>
      </div>

      <div class="stack-12" style="max-width: 320px;">
        <%= f.submit "登録する", class: "btn btn--primary btn--block" %>
      </div>
    <% end %>

    <div class="auth-links">
      <%= render "customers/shared/links" %>
    </div>
  </div>
</section>