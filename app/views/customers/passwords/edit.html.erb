<section class="section">
  <h1 class="h1">新しいパスワード</h1>

  <div class="stack-24">
    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "form" }) do |f| %>
      <%= render "customers/shared/error_messages", resource: resource %>
      <%= f.hidden_field :reset_password_token %>

      <div class="form__row">
        <%= f.label :password, "新しいパスワード", class: "form__label" %>
        <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "form__input" %>
        <% if @minimum_password_length %>
          <div class="text-sm text-muted"><%= @minimum_password_length %>文字以上</div>
        <% end %>
      </div>

      <div class="form__row">
        <%= f.label :password_confirmation, "新しいパスワード（確認）", class: "form__label" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form__input" %>
      </div>

      <div class="stack-12" style="max-width: 420px;">
        <%= f.submit "変更する", class: "btn btn--primary btn--block" %>
      </div>
    <% end %>

    <div class="auth-links">
      <%= render "customers/shared/links" %>
    </div>
  </div>
</section>