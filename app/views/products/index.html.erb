<h1>商品一覧</h1>

<%= form_with url: products_path, method: :get, local: true do %>
  <div style="display:flex; gap:12px; flex-wrap; align-items:flex-end;">
    <div>
      <label>検索</label><br>
      <input type="text" name="q" value="<%= @q %>" placeholder="商品名 / 説明">
    </div>

    <div>
      <label>並び替え</label><br>
      <select name="sort">
        <option value="updated_at_desc" <%= "selected" if @sort == "updated_at_desc" %>>新しい順</option>
        <option value="updated_at_asc"  <%= "selected" if @sort == "updated_at_asc"  %>>古い順</option>
      </select>
    </div>

    <div>
      <% Product::CATEGORIES.each do |c| %>
        <%= link_to c, products_path(request.query_parameters.merge(category: c, page: 1)) %>
      <% end %>
      <%= link_to "all", products_path(request.query_parameters.except(:category).merge(page: 1)) %>
    </div>

    <div>
      <button type="submit">検索</button>
      <%= link_to "クリア", products_path %>
    </div>
  </div>
<% end %>

<hr>

<div style="display:grid; grid-template-columns:repeat(4, 1fr); gap:24px;">
  <% @products.each do |p| %>
    <div style="text-align:center;">
      <div style="height:220px; display:flex; justify-content:center; align-items:center;">
        <% if p.main_image.attached? %>
          <%= image_tag p.main_image, style: "width: 157px; height: 180px; object-fit:cover;" %>
        <% end %>
      </div>

      <div>(ブランド名)</div>
      <div><%= link_to p.name, product_path(p) %></div>
      <div><%= number_to_currency(p.price_cents, unit: "¥", precision: 0) %></div>
    </div>
  <% end %>
</div>


<hr>

<% page = (@page || 1).to_i %>
<% total_pages = (@total_pages || 1).to_i %>

<div style="display:flex; gap:12px; align-items:center;">
  <div>total: <%= @total %></div>
  <div>page: <%= page %> / <%= [total_pages, 1].max %></div>

  <div style="margin-left:auto;">
    <% if page > 1 %>
      <%= link_to "前へ", products_path(request.query_parameters.merge(page: page - 1)) %>
    <% end %>

    <% if page < total_pages %>
      <%= link_to "次へ", products_path(request.query_parameters.merge(page: page + 1)) %>
    <% end %>
  </div>
</div>